{
  "manifest_version": 3,
  "name": "沦敦故事回顾 Fallen London Chronicle",
  "short_name": "沦敦故事回顾",
  "version": "1.6.0",
  "description": "完整记录沦敦（Fallen London）里每次选择的故事、选项与结果原文，并可导入游戏日志，导出为故事回顾阅读器格式。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "沦敦故事回顾",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "https://www.fallenlondon.com/*",
    "https://fallenlondon.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.fallenlondon.com/*",
        "https://fallenlondon.com/*"
      ],
      "js": [
        "page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "homepage_url": "https://github.com/Dobo233/fallen-london-chronicle",
  "browser_specific_settings": {
    "gecko": {
      "id": "fallen-london-chronicle@dobo233",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
